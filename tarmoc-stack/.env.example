# Copy to .env, then edit before deploying.

# --- Postgres ---
POSTGRES_USER=tarmoc
POSTGRES_PASSWORD=tarmoc_password
POSTGRES_DB=tarmoc

# --- API ---
API_PORT=4000
ADMIN_API_KEY=change_me_admin_key
OFFLINE_AFTER_SECONDS=90

# --- Dashboard ---
DASHBOARD_PORT=8088

# --- Agent (monitors the Docker host itself) ---
AGENT_SERVER_NAME=tarmoc-ai
AGENT_ENVIRONMENT=production
AGENT_TYPE=Physical server
AGENT_TAGS=role:host,location:jakarta
AGENT_INTERVAL_SECONDS=15

# Path to the Docker socket on the HOST that the agent should read container
# stats from. Check yours with `docker context ls` (look at DOCKER ENDPOINT for
# the active context, marked with *) — rootless Docker usually isn't at the
# default /var/run/docker.sock, it's something like /run/user/1001/docker.sock.
DOCKER_SOCK_PATH=/var/run/docker.sock
